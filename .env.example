# AutoJudge Platform — Production Environment Configuration

# Database Connection (PostgreSQL with pgvector)
DATABASE_URL=postgresql://admin:password@localhost:5433/submissions_db

# Redis Broker (Celery Task Orchestration)
REDIS_URL=redis://localhost:6379/0

# Application Environment & Logging
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Razorpay Monetization & Metered Billing
# Leave empty or set to rzp_test_simulated_key to run in offline simulation mode
RAZORPAY_KEY_ID=rzp_test_simulated_key
RAZORPAY_KEY_SECRET=simulated_secret_key_12345
RAZORPAY_WEBHOOK_SECRET=simulated_webhook_secret_67890
RAZORPAY_SIMULATION=true

# Code Execution Sandbox Configuration
# Options: 'docker' (standard MicroVM containers), 'e2b' (E2B cloud MicroVMs), 'fallback' (active psutil cgroup monitor)
SANDBOX_PROVIDER=docker
E2B_API_KEY=

# Local Target Repo Directory for Evaluations
SUBMISSION_REPO_DIR=.
