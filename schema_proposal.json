{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HackathonAutoJudgeReport",
  "description": "Proposed schema for the final evaluation report of a hackathon submission, incorporating critical reliability, tracing, and review controls.",
  "type": "object",
  "required": [
    "submission_id",
    "team_name",
    "repo_url",
    "commit_sha",
    "pipeline_status",
    "pipeline_started_at",
    "pipeline_completed_at",
    "overall_score",
    "synthesis_summary",
    "requires_manual_review",
    "review_status",
    "reviewed_by",
    "dimensions"
  ],
  "properties": {
    "submission_id": {
      "type": "string",
      "description": "Unique identifier for the submission (e.g., 'sub_001')."
    },
    "team_name": {
      "type": "string",
      "description": "Name of the hackathon team."
    },
    "repo_url": {
      "type": "string",
      "format": "uri",
      "description": "URL of the team's repository."
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "GAP RESOLVED: 40-character git commit SHA checked out and evaluated, ensuring build and test run repeatability."
    },
    "pipeline_status": {
      "type": "string",
      "enum": ["pending", "running", "complete", "failed"],
      "description": "Overall status of the evaluation runner pipeline."
    },
    "pipeline_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "GAP RESOLVED: ISO 8601 timestamp when the overall pipeline run was initiated."
    },
    "pipeline_completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "GAP RESOLVED: ISO 8601 timestamp when the overall pipeline finished. Null if running/pending."
    },
    "overall_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "description": "Aggregated overall composite score calculated by the synthesis agent."
    },
    "synthesis_summary": {
      "type": [
        "string",
        "null"
      ],
      "description": "GAP RESOLVED: Textual summary generated by the synthesis agent explaining the final grade reasoning."
    },
    "global_pipeline_error": {
      "type": [
        "string",
        "null"
      ],
      "description": "GAP RESOLVED: Logs system-level errors (e.g., clone failures, orchestrator bugs) that occur before individual dimensions can be initialized."
    },
    "requires_manual_review": {
      "type": "boolean",
      "description": "GAP RESOLVED: Flag indicating if a judge needs to manually review code flags (e.g., plagiarism detection or security smell)."
    },
    "review_status": {
      "type": "string",
      "enum": ["unreviewed", "in_review", "approved", "rejected"],
      "description": "GAP RESOLVED: Current state of the manual review process."
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "GAP RESOLVED: Operator/Judge ID of the reviewer handling manual interventions."
    },
    "dimensions": {
      "type": "object",
      "required": [
        "code_quality",
        "functionality",
        "originality",
        "innovation"
      ],
      "properties": {
        "code_quality": {
          "$ref": "#/$defs/dimension_report"
        },
        "functionality": {
          "$ref": "#/$defs/functionality_report"
        },
        "originality": {
          "$ref": "#/$defs/dimension_report"
        },
        "innovation": {
          "$ref": "#/$defs/dimension_report"
        }
      }
    }
  },
  "$defs": {
    "dimension_report": {
      "type": "object",
      "required": [
        "status",
        "score",
        "summary",
        "flags",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "running", "complete", "failed"]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "message"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "reference_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "GAP RESOLVED: Agent-specific run start timestamp for profiling latency."
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "GAP RESOLVED: Agent-specific completion timestamp."
        },
        "error_message": {
          "type": [
            "string",
            "null"
          ],
          "description": "Specific agent execution runtime failure dump."
        }
      }
    },
    "functionality_report": {
      "allOf": [
        {
          "$ref": "#/$defs/dimension_report"
        },
        {
          "type": "object",
          "properties": {
            "raw_metrics": {
              "type": "object",
              "required": [
                "tests_passed",
                "total_tests",
                "avg_runtime_ms",
                "peak_memory_mb"
              ],
              "properties": {
                "tests_passed": {
                  "type": "integer"
                },
                "total_tests": {
                  "type": "integer"
                },
                "avg_runtime_ms": {
                  "type": "number"
                },
                "peak_memory_mb": {
                  "type": "number"
                },
                "test_cases": {
                  "type": "array",
                  "description": "GAP RESOLVED: Detailed diagnostic metrics listing every compiled test case, its result status, runtime, and stderr output.",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "status",
                      "duration_ms"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string",
                        "enum": ["pass", "fail", "error"]
                      },
                      "duration_ms": {
                        "type": "number"
                      },
                      "error_trace": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}